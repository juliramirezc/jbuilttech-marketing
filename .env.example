# Copy relevant keys into .env.local / Vercel Environment Variables.
# Never expose these as NEXT_PUBLIC_*.

# --- Existing site (if already set) ---
LEAD_WEBHOOK_URL=

# --- DC 78 Member Story: keyless Google auth (Vercel OIDC + GCP WIF) ---
# Do NOT set GOOGLE_PRIVATE_KEY. Org blocks SA JSON keys.
#
# Required on Vercel Production (and when testing with `vercel env pull`):
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=unionsharedfiles@union-506213.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-oidc
# Optional override; default is derived from project number + pool + provider:
# GCP_AUDIENCE=https://iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/vercel/providers/vercel-oidc
GOOGLE_SHARED_DRIVE_ID=0ABeqR7jO6Kt3Uk9PVA
# Optional: pin folder/sheet IDs on the NEW shared drive only (leave empty to auto-create)
GOOGLE_MEMBER_STORY_ROOT_FOLDER_ID=
GOOGLE_MEMBER_STORY_SHEET_ID=
# Optional: pin "Applications Construction" spreadsheet (otherwise created under Applications Construction/)
GOOGLE_GEOFENCE_SPREADSHEET_ID=
# Optional: pin Marion Building Union Power spreadsheet (otherwise find/create
# "Marion County Union Building Power clas" under Applications Public Sector/)
GOOGLE_MARION_BUP_SPREADSHEET_ID=
# Optional: pin Leon Building Union Power spreadsheet (otherwise find/create
# under Union Building Power Classes/)
GOOGLE_LEON_BUP_SPREADSHEET_ID=
# Optional: token for POST /api/building-union-power/organize-drive
# BUP_ORGANIZE_TOKEN=

# --- Notification email (Postmark) for member-story staff alerts ---
MEMBER_STORY_NOTIFY_EMAIL=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=marketing@lu1010.org
# Optional; defaults to outbound (transactional) for staff notifications
POSTMARK_MESSAGE_STREAM=outbound

# --- DC 78 newsletter console (/dc78/newsletter) — Broadcast Bulk only ---
# Password gate (server-side session cookie). Do not commit real values.
NEWSLETTER_ADMIN_EMAIL=
NEWSLETTER_ADMIN_PASSWORD=
NEWSLETTER_SESSION_SECRET=
# Or reuse SESSION_SECRET (min 32 chars) if NEWSLETTER_SESSION_SECRET is unset
# SESSION_SECRET=
POSTMARK_TEMPLATE_ALIAS=
# POSTMARK_TEMPLATE_ID=
POSTMARK_BROADCAST_STREAM=public-sector-newsletter
POSTMARK_REPLY_TO_EMAIL=marketing@lu1010.org
POSTMARK_FROM_NAME=JBuiltTech
POSTMARK_CAMPAIGN_TAG=public-sector-newsletter
