# Copy relevant keys into .env.local / Vercel Environment Variables.
# Never expose these as NEXT_PUBLIC_*.

# --- Existing site (if already set) ---
LEAD_WEBHOOK_URL=

# --- DC 78 Member Story (Google Drive + Sheets) ---
# Required in Vercel Production (values never committed):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHARED_DRIVE_ID=
# Optional: pin the Member-newsletter-stories folder ID (otherwise created/found by name)
GOOGLE_MEMBER_STORY_ROOT_FOLDER_ID=
# Optional: pin the "DC78 Member Story Submissions" spreadsheet ID
GOOGLE_MEMBER_STORY_SHEET_ID=

# --- Notification email (Postmark) ---
MEMBER_STORY_NOTIFY_EMAIL=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Optional; defaults to outbound (transactional) for staff notifications
POSTMARK_MESSAGE_STREAM=outbound
